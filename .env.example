# ========================================
# Chore Wars — Environment Reference
# ========================================
# This file is a TEMPLATE. Do NOT put real passwords here.
# ASP.NET Core does NOT auto-read .env files.
# Use OS environment variables, launchSettings.json, or User Secrets instead.

# ---- Mode ----
# "Development" = Docker local | "Supabase" = cloud
ASPNETCORE_ENVIRONMENT=Development

# ---- Docker Local (default, matches appsettings.Development.json) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chorewars
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5435;Database=chorewars;Username=postgres;Password=postgres

# ---- Supabase ----
# Copy connection string from Supabase Dashboard → Connect
# Use direct connection for migrations, session pooler if IPv6 not supported
# ConnectionStrings__DefaultConnection=Host=db.xxxxxxxxxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your-password

# ---- JWT ----
JWT_SECRET=chorewars_super_secret_key_which_should_be_long_enough_for_hmac_sha256

# ---- Redis ----
# REDIS_CONNECTION=localhost:6380

# ---- Kafka ----
# KAFKA_BOOTSTRAP=localhost:9094

# Private uploads: use a persistent path outside wwwroot. Compose maps this to a named volume.
MediaStorage__RootPath=/app/private-media

# AI opt-in: docker compose -f docker-compose.yml -f docker-compose.ai.yml up --build -d
# Generate these locally; never commit real values. Percent-encode reserved characters in the database password URL.
AI_SERVICE_KEY=
AI_POSTGRES_PASSWORD=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash

# Google sign-in: public OAuth client ID, never a Gemini API key or SMTP password.
# Configure these directly in the backend environment; frontend uses GOOGLE_WEB_CLIENT_ID at build time.
GoogleAuth__Enabled=false
GoogleAuth__ClientIds__0=
GOOGLE_WEB_CLIENT_ID=

# Backend SMTP for explicit Order Send actions. Do not commit real credentials.
OrderEmail__Host=smtp.gmail.com
OrderEmail__Port=587
OrderEmail__EnableSsl=true
OrderEmail__Username=
OrderEmail__Password=
OrderEmail__FromAddress=
OrderEmail__FromName=ChoreWar
