# ========================================
# Chore Wars — Environment Reference
# ========================================
# This file is a TEMPLATE. Do NOT put real passwords here.
# ASP.NET Core does NOT auto-read .env files.
# Use OS environment variables, launchSettings.json, or User Secrets instead.

# ---- Mode ----
# "Development" = Docker local | "Supabase" = cloud
ASPNETCORE_ENVIRONMENT=Development

# ---- Docker Local (default, matches appsettings.Development.json) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chorewars
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5435;Database=chorewars;Username=postgres;Password=postgres

# ---- Supabase ----
# Copy connection string from Supabase Dashboard → Connect
# Use direct connection for migrations, session pooler if IPv6 not supported
# ConnectionStrings__DefaultConnection=Host=db.xxxxxxxxxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your-password

# ---- JWT ----
JWT_SECRET=chorewars_super_secret_key_which_should_be_long_enough_for_hmac_sha256

# ---- Redis ----
# REDIS_CONNECTION=localhost:6380

# ---- Kafka ----
# KAFKA_BOOTSTRAP=localhost:9094
